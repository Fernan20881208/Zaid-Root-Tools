    "haptic-title": {
      "type": "title",
      "name": "Haptic Engine (Android)"
    },
    "haptic-enable": {
      "type": "bool",
      "name": "Activar Haptic Engine",
      "default": false,
      "description": "Usa las APIs de vibracion Android. No requiere root; Input Mapper conserva su soporte su."
    },
    "haptic-intensity": {
      "type": "int",
      "name": "Intensidad (%)",
      "default": 45,
      "min": 1,
      "max": 100,
      "description": "Intensidad solicitada a Android. Algunos motores solo admiten intensidad fija.",
      "control": {
        "slider": true
      }
    },
    "haptic-jump-cooldown": {
      "type": "int",
      "name": "Intervalo minimo salto (ms)",
      "default": 90,
      "min": 60,
      "max": 500,
      "control": {
        "slider": false,
        "arrows": true,
        "input": true
      }
    },
    "haptic-jump": {
      "type": "bool",
      "name": "Vibrar al salto",
      "default": true
    },
    "haptic-jump-ms": {
      "type": "int",
      "name": "Duracion Salto (ms)",
      "default": 12,
      "min": 1,
      "max": 250,
      "control": {
        "slider": false,
        "arrows": true,
        "input": true
      }
    },
    "haptic-death": {
      "type": "bool",
      "name": "Vibrar al muerte",
      "default": true
