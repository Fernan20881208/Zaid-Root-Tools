      "default": true
    },
    "haptic-checkpoint-ms": {
      "type": "int",
      "name": "Duracion Checkpoint (ms)",
      "default": 35,
      "min": 1,
      "max": 250,
      "control": {
        "slider": false,
        "arrows": true,
        "input": true
