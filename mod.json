{
  "geode": "5.11.2",
  "gd": {
    "android": "2.2081"
  },
  "id": "zaid.root-input-mapper",
  "name": "Zaid Root Tools",
  "version": "v0.3.1",
  "developer": "Zaid",
  "description": "Input Mapper con root y Haptic Engine con vibracion por saltos, muertes, checkpoints y mas para Android ARM64.",
  "settings": {
    "mapper-section": {
      "type": "title",
      "name": "Root Input Mapper"
    },
    "enable-root-mapper": {
      "type": "bool",
      "name": "Activar mapper con root",
      "default": false,
      "description": "Solicita su y escucha solo el dispositivo seleccionado. Desactivalo antes de cambiar de dispositivo."
    },
    "event-device": {
      "type": "int",
      "name": "Numero de /dev/input/eventN",
      "default": -1,
      "min": -1,
      "max": 63,
      "description": "Ejemplo: 4 para /dev/input/event4. El valor -1 deshabilita el acceso al dispositivo.",
      "control": {
        "slider": false,
        "arrows": true,
        "input": true
      }
    },
    "show-status": {
      "type": "bool",
      "name": "Mostrar estado dentro del nivel",
      "default": true,
      "description": "Muestra OFF, SU, ON o ERROR. Se aplica al entrar a un nuevo nivel."
    },
    "bindings-title": {
      "type": "title",
      "name": "Bindings de acciones"
    },
    "binding-1-key": {
      "type": "string",
      "name": "Entrada 1",
      "default": "VOL_UP",
      "description": "Boton fisico Linux /dev/input que dispara la accion.",
      "one-of": [
        "NONE",
        "VOL_UP",
        "VOL_DOWN",
        "BTN_SOUTH",
        "BTN_EAST",
        "BTN_NORTH",
        "BTN_WEST",
        "BTN_TL",
        "BTN_TR",
        "BTN_SELECT",
        "BTN_START",
        "BTN_MODE",
        "BTN_THUMBL",
        "BTN_THUMBR"
      ]
    },
    "binding-1-action": {
      "type": "string",
      "name": "Accion 1",
      "default": "JUMP_P1",
      "description": "Accion que se ejecuta al presionar la entrada seleccionada.",
      "one-of": [
        "NONE",
        "JUMP_P1",
        "JUMP_P2",
        "JUMP_BOTH",
        "PAUSE",
        "RESTART",
        "FULL_RESTART",
        "PRACTICE_TOGGLE",
        "PLACE_CHECKPOINT",
        "LOAD_LAST_CHECKPOINT",
        "CLEAR_CHECKPOINTS"
      ]
    },
    "binding-2-key": {
